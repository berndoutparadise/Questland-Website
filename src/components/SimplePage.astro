---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { getContent } from "../data/content";
import type { Locale } from "../data/quest";
import { localePath, withBase } from "../utils/sitePaths";

type Props = {
  locale: Locale;
  kind: "thanks" | "legal" | "privacy";
};

const { locale, kind } = Astro.props;
const t = getContent(locale);
const homePath = localePath(locale);
const homeHref = withBase(homePath);
const requestPath = locale === "de" ? localePath("de", "/anfrage/") : localePath("en", "/request/");
const requestHref = withBase(requestPath);
const isThanks = kind === "thanks";
const titleMap = {
  de: { legal: "Impressum", privacy: "Datenschutz" },
  en: { legal: "Legal notice", privacy: "Privacy" }
};
const pageTitle = isThanks ? t.thanks.title : titleMap[locale][kind as "legal" | "privacy"];
const canonicalPath = isThanks
  ? locale === "de" ? localePath("de", "/danke/") : localePath("en", "/thanks/")
  : kind === "legal"
    ? locale === "de" ? localePath("de", "/impressum/") : localePath("en", "/legal-notice/")
    : locale === "de" ? localePath("de", "/datenschutz/") : localePath("en", "/privacy/");
const alternateDe = isThanks ? localePath("de", "/danke/") : kind === "legal" ? localePath("de", "/impressum/") : localePath("de", "/datenschutz/");
const alternateEn = isThanks ? localePath("en", "/thanks/") : kind === "legal" ? localePath("en", "/legal-notice/") : localePath("en", "/privacy/");
---

<SiteLayout
  {locale}
  title={`${pageTitle} · Questland`}
  description={isThanks ? t.thanks.text : t.legalPlaceholder}
  {canonicalPath}
  {alternateDe}
  {alternateEn}
  noindex
>
  <div class="site-shell site-shell--subpage">
    <Header
      {locale}
      deHref={withBase(alternateDe)}
      enHref={withBase(alternateEn)}
      {homeHref}
      {requestHref}
      simple
    />
    <main id="main" class="simple-page">
      <div class="page">
        <section class:list={["simple-panel", isThanks && "simple-panel--thanks"]}>
          <p class="kicker">{isThanks ? t.thanks.kicker : "QUESTLAND"}</p>
          <h1>{pageTitle}</h1>
          <p>{isThanks ? t.thanks.text : t.legalPlaceholder}</p>
          {!isThanks && (
            <div class="legal-warning" role="note">
              <strong>{locale === "de" ? "Noch nicht veröffentlichungsbereit" : "Not ready for publication"}</strong>
              <span>{t.legalPlaceholder}</span>
            </div>
          )}
          <a class="button button--adventure" href={homeHref}>{isThanks ? t.thanks.back : locale === "de" ? "Zur Startseite" : "Back to homepage"}</a>
        </section>
      </div>
    </main>
    <Footer {locale} {homeHref} />
  </div>
</SiteLayout>
